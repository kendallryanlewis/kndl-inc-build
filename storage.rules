rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Profile pictures - users can upload their own profile pictures
    match /profile-pictures/{fileName} {
      allow read: if true; // Anyone can view profile pictures
      allow write: if request.auth != null 
                   && request.auth.uid != null
                   && resource == null  // Allow new files
                   && fileName.matches('.*\\.(jpg|jpeg|png|gif|webp)$') // Only image files
                   && request.resource.size < 5 * 1024 * 1024; // Max 5MB
      allow delete: if request.auth != null 
                    && request.auth.uid != null;
    }
    
    // Default rule - deny all other access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
