// Firebase Storage Security Rules - DEVELOPMENT ONLY
// Use this temporarily to test uploads, then switch to production rules

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Temporary: Allow all authenticated users to upload profile pictures
    match /profile-pictures/{allFiles=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024 // Max 5MB
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }
    
    // Default deny all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}