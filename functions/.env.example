# Firebase Functions Environment Configuration
# Copy this file to .env and fill in your actual values

# Stripe API Keys
STRIPE_TEST_SECRET_KEY=sk_test_...
STRIPE_LIVE_SECRET_KEY=sk_live_...

# Apple App Store Connect API
APPLE_ASC_KEY_ID=YOUR_APP_STORE_CONNECT_KEY_ID
APPLE_ASC_ISSUER_ID=YOUR_APP_STORE_CONNECT_ISSUER_ID
APPLE_ASC_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_APPLE_PRIVATE_KEY_CONTENT\n-----END PRIVATE KEY-----"

# Firebase Configuration
FIREBASE_PROJECT_ID=kndl-3663b

# Other Environment Variables
NODE_ENV=development

# Contact Form Email (choose one method)
# Option A: Gmail
CONTACT_GMAIL_USER=kndl-inc@gmail.com
CONTACT_GMAIL_APP_PASSWORD=your_google_app_password

# Option B: SMTP
# CONTACT_SMTP_HOST=smtp.gmail.com
# CONTACT_SMTP_PORT=587
# CONTACT_SMTP_SECURE=false
# CONTACT_SMTP_USER=kndl-inc@gmail.com
# CONTACT_SMTP_PASS=your_smtp_password

# Optional sender override
# CONTACT_FROM_EMAIL="KNDL Contact <kndl-inc@gmail.com>"

# Instructions:
# 1. Copy this file: cp .env.example .env
# 2. Replace all ... placeholders with your actual API keys
# 3. Never commit the actual .env file to git
# 4. Keep this template updated when adding new environment variables